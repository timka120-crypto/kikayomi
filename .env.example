# ─────────────────────────────────────────────────────────────
#  BEKAKOTAK — переменные окружения
#  Скопируйте в .env.local (локально) или задайте в панели хостинга.
#  Без настроенного канала заказов сайт работает, но честно сообщает,
#  что онлайн-приём заказов ещё не подключён, и НЕ очищает корзину.
# ─────────────────────────────────────────────────────────────

# Публичный адрес сайта (для SEO: canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://bekakotak.kz

# ── Канал 1: уведомления о заказах в Telegram (рекомендуется) ──
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# ID чата/группы, куда приходят заказы. Можно несколько через запятую.
TELEGRAM_CHAT_ID=

# ── Канал 2: webhook в CRM / POS / n8n / Make / Google Sheets ──
ORDER_WEBHOOK_URL=
# Необязательно: подпись X-BekaKotak-Signature: sha256=<HMAC тела запроса>
ORDER_WEBHOOK_SECRET=

# ── Канал 3: запись заказов в файл (локальная разработка / один VPS) ──
# Не используйте на serverless-хостинге (Vercel): файловая система там временная.
ORDERS_LOCAL_FILE=false
ORDERS_LOCAL_FILE_PATH=.data/orders.jsonl
